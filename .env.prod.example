# Copie para .env na VPS (na pasta do deploy do front) e preencha.

# Tag da imagem no GHCR (latest ou sha-xxxxxxx)
IMAGE_TAG=latest

# Domínio público do front (DNS apontando para a VPS). A API fica em https://APP_DOMAIN/api
APP_DOMAIN=app.seudominio.com
# Certresolver do Traefik: letsencrypt (DNS na Cloudflare) ou letsencrypt-http
TRAEFIK_CERTRESOLVER=letsencrypt

# Endereço do back-end na rede "web" (nome do container da API)
API_UPSTREAM=http://gymnasion_app:8080

# Limites de recursos
WEB_CPUS=0.25
WEB_MEM_LIMIT=64m

# No .env do BACK-END, use o mesmo domínio:
#   FRONTEND_URL=https://app.seudominio.com
#   STRAVA_REDIRECT_URI=https://app.seudominio.com/strava/callback
